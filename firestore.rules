rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /nremtProgress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /nremtExamState/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /nremtProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /questionStats/{id} {
      // Community per-question response aggregates (itemStats.js) — every
      // signed-in user increments these via recordResponse(), so there is
      // no single owner uid to check against.
      allow read, write: if request.auth != null;
    }

    match /crowdsourcedQuestions/{id} {
      allow create: if request.auth != null
        && request.resource.data.status == "pending"
        && request.resource.data.submittedBy == request.auth.uid;
      allow read: if request.auth != null;
      // TODO: replace with a real server-verified admin check (custom claim)
      // before relying on this for anything beyond local development.
      allow update: if request.auth != null;
    }

    match /questionReports/{id} {
      allow create: if request.auth != null
        && request.resource.data.status == "pending"
        && request.resource.data.reportedBy == request.auth.uid;
      allow read: if request.auth != null;
      // TODO: same caveat as above.
      allow update: if request.auth != null;
    }

    match /eduGlobalStats/{id} {
      // Aggregate, non-identifying engagement counters (globalStats.js) —
      // same "every signed-in user increments these" shape as questionStats.
      allow read, write: if request.auth != null;
    }

    match /nremtPredictions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /nremtMedicdle/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
